# Copy to careerpilot/.env (gitignored). Never commit real values or paste them into chat.
# Values marked (auto) are written for you by the scripts in SETUP.md.

# ── Database: Turso free tier (hosted libSQL). Leave unset locally to use careerpilot/.data/careerpilot.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Encryption & dashboard auth (auto: npm run setup -- keys / npm run setup -- password)
APP_ENCRYPTION_KEY=
SESSION_SECRET=
DASHBOARD_PASSWORD_HASH=
# Set to 1 on Vercel for the read-only deployment
DASHBOARD_READONLY=

# ── Gmail API: Google Cloud OAuth client of type "Web application" (see SETUP.md §4).
# Connect from the dashboard (Settings → Gmail); the token is stored encrypted in the database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: fixed public address of the dashboard, if the redirect URI must not follow the Host header
APP_BASE_URL=

# ── Free-tier AI providers (all optional; the pipeline queues AI work when none is available)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides. OpenRouter accepts only ":free" models.
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
